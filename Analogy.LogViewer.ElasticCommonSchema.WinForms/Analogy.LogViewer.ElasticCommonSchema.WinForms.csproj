<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Library</OutputType>
		<UseWindowsForms>true</UseWindowsForms>
		<TargetFrameworks>net10.0-windows;net9.0-windows;net8.0-windows;net48</TargetFrameworks>
		<VersionPrefix>9.0.6.1</VersionPrefix>
		<VersionSuffix></VersionSuffix>
		<AssemblyName>Analogy.LogViewer.ElasticCommonSchema.WinForms</AssemblyName>
		<PackageId>Analogy.LogViewer.ElasticCommonSchema.WinForms</PackageId>
		<Authors>Lior Banai</Authors>
		<Description>Elastic Common Schema (ECS) parser (Serilog)</Description>
		<Copyright>Lior Banai 2023-2026</Copyright>
		<PackageProjectUrl>https://github.com/Analogy-LogViewer/Analogy.LogViewer.ElasticCommonSchema</PackageProjectUrl>
		<RepositoryUrl>https://github.com/Analogy-LogViewer/Analogy.LogViewer.ElasticCommonSchema</RepositoryUrl>
		<PackageReleaseNotes></PackageReleaseNotes>
		<PackageIcon>AnalogyECS128x128.png</PackageIcon>
		<Company>Analogy.LogViewer</Company>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Analogy.CommonUtilities" />
		<PackageReference Include="Analogy.LogViewer.Interfaces" />
		<PackageReference Include="Analogy.LogViewer.Template" />
		<PackageReference Include="Analogy.LogViewer.Template.WinForms" />
		<PackageReference Include="Elastic.CommonSchema" />
		<PackageReference Include="Elastic.CommonSchema.Serilog" />
		<PackageReference Include="Microsoft.SourceLink.GitHub">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Newtonsoft.Json" />
		<PackageReference Include="Serilog" />
		<PackageReference Include="System.Resources.Extensions" />
	</ItemGroup>
	<ItemGroup>
		<Compile Update="Properties\Resources.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Resources.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Properties\Resources.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>Resources.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<None Include="..\Assets\AnalogyECS128x128.png">
		  <Pack>True</Pack>
		  <PackagePath>\</PackagePath>
		</None>
		<None Include="..\Nuget\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>
